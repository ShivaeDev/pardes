#!/usr/bin/env bash
# gpr — a thin branch -> commit -> push -> PR DSL.
#
# Subcommands:
#   gpr start <branch>              create a branch (namespaced by SH_BRANCH_PREFIX)
#   gpr commit <subject> [body]     commit staged changes
#   gpr commit-all <subject> [body] stage everything, then commit
#   gpr push                        push current branch, set upstream
#   gpr pr [gh args...]             open a PR (requires gh; degrades clearly)
#   gpr ship <subject> [body]       commit-all + push + pr
#   gpr start-ship <branch> <subject> [body]   start + ship
#
# All project-specifics are env vars (SH_BRANCH_PREFIX); gh is optional.
set -eu

SH_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../shell/helpers.sh
. "$SH_DIR/shell/helpers.sh"

usage() {
  cat <<'EOF'
gpr — a thin branch -> commit -> push -> PR DSL.

Subcommands:
  gpr start <branch>                          create a branch (namespaced by SH_BRANCH_PREFIX)
  gpr commit <subject> [body]                 commit staged changes
  gpr commit-all <subject> [body]             stage everything, then commit
  gpr push                                    push current branch, set upstream
  gpr pr [gh args...]                         open a PR (requires gh; degrades clearly)
  gpr ship <subject> [body]                   commit-all + push + pr
  gpr start-ship <branch> <subject> [body]    start + ship

All project-specifics are env vars (SH_BRANCH_PREFIX); gh is optional.
EOF
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  start)        sh_start "$@" ;;
  commit)       sh_commit "$@" ;;
  commit-all)   sh_commit_all "$@" ;;
  push)         sh_push "$@" ;;
  pr)           sh_pr "$@" ;;
  ship)         sh_ship "$@" ;;
  start-ship)   sh_start_ship "$@" ;;
  ""|-h|--help|help) usage ;;
  *)
    printf 'gpr: unknown subcommand %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
