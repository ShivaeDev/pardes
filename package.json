{
  "name": "pardes",
  "version": "0.0.0",
  "private": true,
  "description": "A calm-coding marketplace of plugins and skills for coding agents.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "ci": "biome ci .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings --write .",
    "references:effect": "bash plugins/pardes-pi/scripts/sync-effect-reference.sh",
    "ready:summary": "bun plugins/pardes-pi/scripts/ready-summary.ts",
    "review:summary": "bun plugins/pardes-pi/scripts/review-summary.ts",
    "test": "vitest run",
    "test:codex": "bun run --sequential 'test:codex:*'",
    "test:codex:configure-workstream": "uv run python -B plugins/codex-workstreams/skills/configure-workstream/scripts/test_check_setup.py",
    "test:codex:implement-change": "uv run python -B plugins/codex-workstreams/skills/implement-change/scripts/test_manage_worker_worktree.py",
    "test:codex:run-pr-cycle": "uv run python -B plugins/codex-workstreams/skills/run-pr-cycle/scripts/test_watch_pr.py",
    "typecheck": "tsc -p plugins/statusline/tsconfig.json --noEmit && bun run typecheck:pi",
    "typecheck:pi": "tsc -p plugins/pardes-pi/tsconfig.json --noEmit",
    "ready": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run test:codex"
  },
  "dependencies": {
    "effect": "4.0.0-beta.70"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "pi": {
    "extensions": [
      "./plugins/pardes-pi/extensions/pardes/index.ts"
    ],
    "skills": [
      "./plugins/pardes-pi/skills"
    ]
  }
}
