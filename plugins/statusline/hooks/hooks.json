{
  "description": "Refreshes the stable statusline launcher each session and offers to wire the main status line to this plugin.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  }
}
